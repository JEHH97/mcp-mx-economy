{
  "name": "@x/mcp-mx-economy",
  "version": "1.0.0",
  "description": "An MCP server for Mexican economic indicators from public Banxico and INEGI APIs.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mexico",
    "banxico",
    "inegi",
    "economics",
    "indicators",
    "exchange-rate",
    "inflation",
    "ai-tools"
  ],
  "homepage": "https://github.com/JEHH97/mcp-mx-economy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JEHH97/mcp-mx-economy.git"
  },
  "bugs": {
    "url": "https://github.com/JEHH97/mcp-mx-economy/issues"
  },
  "author": "Jesús Enrique Hernández Herrera <jesush1236@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "mcp-mx-economy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node24 --clean",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "scan": "node scripts/scan-forbidden.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run smoke && npm run scan",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-stdio.mjs",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "main": "eslint.config.js",
  "directories": {
    "test": "test"
  }
}
